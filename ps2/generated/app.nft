flush ruleset

table inet hostfw {
  chain input {
    type filter hook input priority 0; policy drop;
    iif lo accept
    ct state established,related accept
    ip saddr 10.10.20.10 tcp dport 8080 ct state new accept comment "F2"
    ip saddr 10.10.40.10 tcp dport 22 ct state new limit rate 20/minute burst 20 packets accept comment "F6"
    counter drop
  }
  chain output { type filter hook output priority 0; policy accept; }
}
